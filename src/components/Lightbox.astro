---
interface Shot {
  src: string;
  alt: string;
  caption: string;
}

interface Props {
  images: Shot[];
}

const { images } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
  {images.map(shot => (
    <figure class="bg-gray-100 dark:bg-gray-900 rounded-xl overflow-hidden border border-gray-100 dark:border-gray-700 shadow-sm">
      <button
        type="button"
        class="group relative w-full h-56 flex items-center justify-center p-3 cursor-zoom-in"
        data-lightbox-trigger
        data-src={shot.src}
        data-alt={shot.alt}
        data-caption={shot.caption}
        aria-label={`Ampliar captura: ${shot.alt}`}
      >
        <img src={shot.src} alt={shot.alt} class="max-w-full max-h-full object-contain rounded outline outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10" loading="lazy" />
        <span class="absolute inset-3 rounded bg-black/0 group-hover:bg-black/10 transition flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition drop-shadow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0zM11 8v6m-3-3h6" />
          </svg>
        </span>
      </button>
      <figcaption class="p-4 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
        {shot.caption}
      </figcaption>
    </figure>
  ))}
</div>

<!-- Lightbox -->
<dialog id="lightbox" class="bg-transparent p-0 max-w-[90vw] max-h-[90vh] backdrop:bg-black/80">
  <div class="relative max-w-[90vw] max-h-[90vh] flex flex-col items-center">
    <button
      type="button"
      id="lightbox-close"
      class="absolute -top-3 -right-3 w-9 h-9 rounded-full bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 flex items-center justify-center shadow-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition"
      aria-label="Cerrar"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[80vh] object-contain rounded-lg" />
    <p id="lightbox-caption" class="text-white/90 text-sm text-center mt-4 max-w-2xl"></p>
  </div>
</dialog>

<style>
  dialog#lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
  }
  dialog#lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('lightbox-close');

  document.querySelectorAll('[data-lightbox-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      if (!dialog || !img) return;
      img.src = trigger.getAttribute('data-src') ?? '';
      img.alt = trigger.getAttribute('data-alt') ?? '';
      if (caption) caption.textContent = trigger.getAttribute('data-caption') ?? '';
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
