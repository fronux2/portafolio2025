---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  publishedDate: string;
  author?: string;
  readingTime?: string;
}

const { title, description, publishedDate, author = "Marcos Muñoz", readingTime = "5 min" } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="min-h-screen">
    <!-- Hero del Blog -->
    <section class="py-20 bg-gradient-to-b from-black to-gray-800 text-white lg:px-32 px-6">
      <div class="max-w-3xl mx-auto">
        <a href="/blog" class="text-accent hover:underline text-sm font-medium mb-6 inline-block">← Volver al blog</a>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{title}</h1>
        <p class="text-xl text-gray-300 mb-6">{description}</p>
        <div class="flex flex-wrap gap-4 text-sm text-gray-400">
          <span>Por {author}</span>
          <span>•</span>
          <time datetime={publishedDate}>{new Date(publishedDate).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span>•</span>
          <span>{readingTime} de lectura</span>
        </div>
      </div>
    </section>

    <!-- Contenido -->
    <section class="py-20 bg-white dark:bg-gray-900 lg:px-32 px-6">
      <div class="max-w-3xl mx-auto prose dark:prose-invert prose-lg">
        <slot />
      </div>
    </section>

    <!-- Llamada a Acción -->
    <section class="py-20 bg-gray-50 dark:bg-gray-800 lg:px-32 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">¿Necesitas ayuda con tu proyecto?</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
          Si te interesó este artículo y necesitas desarrollar una web o tienda online, contáctame sin compromiso.
        </p>
        <a href="/#contacto" class="inline-block bg-accent text-black px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition duration-300">
          Solicitar Cotización
        </a>
      </div>
    </section>
  </article>
</Layout>

<style>
  :global(.prose) {
    max-width: none;
  }

  :global(.prose h2) {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: #111827;
  }

  :global(.dark .prose h2) {
    color: #f3f4f6;
  }

  :global(.prose h3) {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #111827;
  }

  :global(.dark .prose h3) {
    color: #f3f4f6;
  }

  :global(.prose p) {
    color: #000000;
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  :global(.dark .prose p) {
    color: #ffffff;
  }

  :global(.prose strong) {
    color: #000000;
    font-weight: 700;
  }

  :global(.dark .prose strong) {
    color: #ffffff;
  }

  :global(.prose ul) {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 1.5rem;
  }

  :global(.prose ul li) {
    margin-bottom: 0.5rem;
  }

  :global(.prose li) {
    color: #000000;
  }

  :global(.dark .prose li) {
    color: #ffffff;
  }

  :global(.prose a) {
    color: #06b6d4;
  }

  :global(.prose a:hover) {
    text-decoration: underline;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  :global(.prose table th),
  :global(.prose table td) {
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    text-align: left;
  }

  :global(.dark .prose table th),
  :global(.dark .prose table td) {
    border-color: #4b5563;
  }

  :global(.prose table th) {
    background-color: #f9fafb;
    font-weight: 600;
  }

  :global(.dark .prose table th) {
    background-color: #1f2937;
  }
</style>
