---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import IconGithub from '../components/icons/Github.astro';
import IconLinkedin from '../components/icons/Linkedin.astro';
import IconAstro from '../components/icons/Astro.astro';
import IconReact from '../components/icons/React.astro';
import IconTailwind from '../components/icons/Tailwind.astro';
import IconNode from '../components/icons/Node.astro';
import IconTypescript from '../components/icons/Typescript.astro';
import IconGit from '../components/icons/Git.astro';
import IconNextjs from '../components/icons/Nextjs.astro';
import IconMysql from '../components/icons/Mysql.astro';
import proyectos  from '../data/proyectos.json';

const categoryColors = {
  Frontend: "bg-accent/10 text-accent dark:bg-accent/15",
  Automatización: "bg-secondary/10 text-secondary dark:bg-secondary/15",
  "Full Stack": "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary",
};

---


<Layout>
  <!-- nav bar -->
  <section class="text-white p-4 bg-black/80 backdrop-blur-md border-b border-white/10 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto">
      <nav class="flex items-center lg:justify-center justify-end pr-6">

        <!-- Botón menú móvil -->
        <input id="menu-toggle" type="checkbox" class="hidden peer" />
        <label for="menu-toggle" class="cursor-pointer md:hidden flex flex-col gap-1.5 p-2 -mr-2">
          <span class="block w-6 h-0.5 bg-white transition-transform duration-300 peer-checked:translate-y-2 peer-checked:rotate-45"></span>
          <span class="block w-6 h-0.5 bg-white transition-opacity duration-300"></span>
          <span class="block w-6 h-0.5 bg-white transition-transform duration-300"></span>
        </label>

        <!-- Menú -->
        <ul
          class="flex flex-col md:flex-row gap-6 md:gap-8 font-semibold text-base md:text-sm items-center
                justify-center absolute md:static left-0 top-full w-full md:w-auto bg-black md:bg-transparent
                p-6 md:p-0 opacity-0 md:opacity-100 pointer-events-none md:pointer-events-auto
                peer-checked:opacity-100 peer-checked:pointer-events-auto transition-all duration-300
                border-b border-white/10 md:border-0">
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#sobre-mi">Sobre mí</a></li>
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#servicios">Servicios</a></li>
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#como-trabajo">Cómo Trabajo</a></li>
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#precios">Precios</a></li>
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#faq">Preguntas Frecuentes</a></li>
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#proyectos">Proyectos</a></li>
          <li><a class="text-gray-300 hover:text-accent transition duration-300" href="#experiencia">Experiencia</a></li>
          <li><a class="rounded-full bg-accent text-black px-4 py-1.5 hover:bg-accent/90 transition duration-300" href="#contacto">Contacto</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <script>
    const menuToggle = document.getElementById('menu-toggle') as HTMLInputElement | null;
    document.querySelectorAll('nav ul a').forEach((link) => {
      link.addEventListener('click', () => {
        if (menuToggle) menuToggle.checked = false;
      });
    });
  </script>

  <!-- Hero Section -->
  <section class="text-white py-28 md:py-40 lg:px-32 px-6 bg-gradient-to-b from-black to-gray-800">
    <div class="container mx-auto px-4 text-center">
      <p class="text-accent text-xs md:text-sm font-semibold uppercase tracking-[0.2em] mb-5 animate-fadeIn">Desarrollo Web · San Bernardo, Chile</p>
      <h1 class="text-white text-4xl md:text-6xl mb-5 animate-fadeIn">Hola, soy <span class="text-accent">Marcos Muñoz</span></h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto text-balance">Tiendas online, páginas web y landing pages que ayudan a tu negocio a vender más.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#contacto" class="bg-accent text-black px-7 py-3 rounded-lg font-semibold hover:bg-accent/90 active:scale-[0.97] transition duration-300 shadow-lg shadow-accent/20">
          Contactarme
        </a>
        <a href="#proyectos" class="border border-white/20 text-white px-7 py-3 rounded-lg font-semibold hover:bg-white/10 active:scale-[0.97] transition duration-300">
          Ver proyectos
        </a>
      </div>
    </div>
  </section>

  <!-- Sobre Mí -->
  <section id="sobre-mi" class="py-20 bg-gray-50 dark:bg-gray-800 lg:px-32 px-6">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl text-gray-900 dark:text-white">Sobre Mí</h2>
        <span class="mt-3 mx-auto block h-1 w-10 rounded-full bg-accent"></span>
      </div>
      <div class="flex flex-col md:flex-row gap-12 items-center">
        <div class="md:w-1/3 flex justify-center">
          <img src="/images/gato-marcos.webp" alt="Marcos Muñoz — desarrollador web en San Bernardo" class="rounded-full w-64 h-64 object-cover border-4 border-white dark:border-gray-700 shadow-xl ring-1 ring-accent/30">
        </div>
        <div class="md:w-2/3">
          <p class="text-lg text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
            Soy Marcos Muñoz, desarrollador web en San Bernardo, Chile. Me especializo en crear tiendas online y sitios web profesionales para emprendedores y pequeños negocios que quieren vender más por internet.
          </p>
          <p class="text-lg text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
            ¿Necesitas <strong class="text-gray-900 dark:text-white font-semibold">crear una página web en San Bernardo</strong>? Mi objetivo es que tengas un sitio que no solo se vea bien, sino que <span class="font-semibold text-gray-900 dark:text-white">atraiga clientes y genere ventas</span>. Sitios rápidos, optimizados para buscadores y pensados para que tu negocio crezca sin complicaciones.
          </p>
          <div class="flex gap-3 justify-center md:justify-start">
            <a href="https://github.com/fronux2" class="rounded-full w-11 h-11 flex items-center justify-center bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:border-accent hover:text-accent transition duration-300">
              <IconGithub class="w-5 h-5" />
            </a>
            <a href="https://www.linkedin.com/in/marcos-mu%C3%B1oz-gonzalez-a32888270/" class="rounded-full w-11 h-11 flex items-center justify-center bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:border-accent hover:text-accent transition duration-300">
              <IconLinkedin class="w-5 h-5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="py-20 lg:px-32 px-6 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl text-gray-900 dark:text-white">Servicios</h2>
        <span class="mt-3 mx-auto block h-1 w-10 rounded-full bg-accent"></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <!-- Tiendas Online -->
        <div class="bg-gray-50 dark:bg-gray-800 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md hover:border-accent/40 hover:-translate-y-0.5 transition duration-300 text-center">
          <div class="text-accent mb-4 flex justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Tiendas Online</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            E-commerce a medida, catálogos digitales y carro de compras. Sitios rápidos, optimizados para buscadores y pensados para vender más.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6 text-sm leading-relaxed">
            Atención en <strong class="text-gray-800 dark:text-gray-200">San Bernardo</strong> y sectores cercanos. Si estás buscando <strong class="text-gray-800 dark:text-gray-200">crear una tienda online en San Bernardo</strong> para tu negocio, yo te ayudo.
          </p>
          <a href="#contacto" class="inline-block border border-accent text-accent px-6 py-2 rounded-lg font-medium hover:bg-accent hover:text-white transition duration-300">
            Contáctame
          </a>
        </div>
        <!-- Páginas Web y Landing Pages -->
        <div class="bg-gray-50 dark:bg-gray-800 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md hover:border-accent/40 hover:-translate-y-0.5 transition duration-300 text-center">
          <div class="text-accent mb-4 flex justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Páginas Web y Landing Pages</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Sitios profesionales para dar presencia digital a tu negocio o proyecto, optimizados para que tus clientes te encuentren en Google.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6 text-sm leading-relaxed">
            ¿Necesitas <strong class="text-gray-800 dark:text-gray-200">crear una página web en San Bernardo</strong>? Diseño sitios rápidos y modernos pensados para hacer crecer tu negocio.
          </p>
          <a href="#contacto" class="inline-block border border-accent text-accent px-6 py-2 rounded-lg font-medium hover:bg-accent hover:text-white transition duration-300">
            Contáctame
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo Trabajo -->
  <section id="como-trabajo" class="py-20 bg-gray-50 dark:bg-gray-800 lg:px-32 px-6">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl text-gray-900 dark:text-white">Cómo Trabajo</h2>
        <span class="mt-3 mx-auto block h-1 w-10 rounded-full bg-accent"></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 max-w-6xl mx-auto relative">
        <!-- Paso 1 -->
        <div class="text-center relative">
          <div class="w-12 h-12 rounded-full bg-accent text-black text-lg font-bold flex items-center justify-center mx-auto mb-5">1</div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Cotización</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
            Me contás tu idea por WhatsApp o el formulario de contacto. En menos de 24h te respondo con precio y plazo exacto.
          </p>
        </div>
        <!-- Paso 2 -->
        <div class="text-center relative">
          <div class="w-12 h-12 rounded-full bg-accent text-black text-lg font-bold flex items-center justify-center mx-auto mb-5">2</div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Diseño</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
            Antes de programar nada, te muestro cómo va a quedar tu sitio. Ajustamos el diseño hasta que te guste.
          </p>
        </div>
        <!-- Paso 3 -->
        <div class="text-center relative">
          <div class="w-12 h-12 rounded-full bg-accent text-black text-lg font-bold flex items-center justify-center mx-auto mb-5">3</div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Desarrollo</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
            Construyo tu web y te voy mostrando avances en el camino, no recién al final.
          </p>
        </div>
        <!-- Paso 4 -->
        <div class="text-center relative">
          <div class="w-12 h-12 rounded-full bg-accent text-black text-lg font-bold flex items-center justify-center mx-auto mb-5">4</div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Entrega</h3>
          <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
            Publico el sitio, te enseño a usarlo y queda listo para recibir clientes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Precios -->
  <section id="precios" class="py-20 bg-white dark:bg-gray-900 lg:px-32 px-6">
    <div class="container mx-auto px-4">
      <div class="text-center mb-4">
        <h2 class="text-3xl md:text-4xl text-gray-900 dark:text-white">Precios</h2>
        <span class="mt-3 mx-auto block h-1 w-10 rounded-full bg-accent"></span>
      </div>
      <p class="text-center text-gray-600 dark:text-gray-300 mb-14 max-w-2xl mx-auto text-balance">
        Valores de referencia para partir. El precio final depende del alcance de tu proyecto, escríbeme y te doy una cotización exacta.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto items-stretch">
        <!-- Landing Page -->
        <div class="flex flex-col bg-white dark:bg-gray-900 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Landing Page</h3>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mb-1 tabular-nums">Desde $80.000</p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Entrega en 5-7 días</p>
          <div class="text-gray-600 dark:text-gray-300 mb-8 text-left space-y-2 flex-1">
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>1 página</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Diseño responsive</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Formulario de contacto</span>
            </p>
          </div>
          <a href="#contacto" class="inline-block border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg font-medium hover:border-accent hover:text-accent transition duration-300">
            Contáctame
          </a>
        </div>
        <!-- Sitio Web / Catálogo -->
        <div class="relative flex flex-col bg-white dark:bg-gray-900 p-8 rounded-xl shadow-lg transition text-center border-2 border-accent">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-accent text-black text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full">Más elegido</span>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 mt-2">Sitio Web / Catálogo</h3>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mb-1 tabular-nums">Desde $150.000</p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Entrega en 7-12 días</p>
          <div class="text-gray-600 dark:text-gray-300 mb-8 text-left space-y-2 flex-1">
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Varias secciones o páginas</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Catálogo de productos o servicios</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Optimizado para buscadores (SEO)</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Formulario de contacto</span>
            </p>
          </div>
          <a href="#contacto" class="inline-block bg-accent text-black px-6 py-2 rounded-lg font-semibold hover:bg-accent/90 transition duration-300">
            Contáctame
          </a>
        </div>
        <!-- Tienda Online -->
        <div class="flex flex-col bg-white dark:bg-gray-900 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Tienda Online</h3>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mb-1 tabular-nums">Desde $280.000</p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Entrega en 15-20 días</p>
          <div class="text-gray-600 dark:text-gray-300 mb-8 text-left space-y-2 flex-1">
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Catálogo de productos</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Carro de compras</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Integración de pagos</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Panel de administración</span>
            </p>
          </div>
          <a href="#contacto" class="inline-block border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg font-medium hover:border-accent hover:text-accent transition duration-300">
            Contáctame
          </a>
        </div>
        <!-- Proyecto a medida -->
        <div class="flex flex-col bg-white dark:bg-gray-900 p-8 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition text-center">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Proyecto a Medida</h3>
          <p class="text-3xl font-bold text-gray-900 dark:text-white mb-1">Cotización</p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Plazo según alcance</p>
          <div class="text-gray-600 dark:text-gray-300 mb-8 text-left space-y-2 flex-1">
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Funcionalidades personalizadas</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Integraciones a medida</span>
            </p>
            <p class="flex items-start gap-2">
              <span class="text-accent shrink-0">✔</span>
              <span>Alcance definido contigo</span>
            </p>
          </div>
          <a href="#contacto" class="inline-block border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 px-6 py-2 rounded-lg font-medium hover:border-accent hover:text-accent transition duration-300">
            Cotizar proyecto
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-gray-50 dark:bg-gray-800 lg:px-32 px-6">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl text-gray-900 dark:text-white">Preguntas Frecuentes</h2>
        <span class="mt-3 mx-auto block h-1 w-10 rounded-full bg-accent"></span>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {[
          {
            q: '¿Emites boleta o factura?',
            a: 'Sí, emito boleta de honorarios electrónica por cada proyecto.',
          },
          {
            q: '¿El precio incluye hosting y dominio?',
            a: 'Sí, el hosting y el dominio están incluidos durante el primer año. A partir del segundo año, la renovación corre por cuenta del cliente.',
          },
          {
            q: '¿Cuántos cambios de diseño puedo pedir?',
            a: 'Incluyo 2 rondas de ajustes de diseño sin costo adicional antes de pasar a desarrollo. Cambios fuera de esas rondas se cotizan aparte.',
          },
          {
            q: '¿Cómo funciona el pago?',
            a: 'Se trabaja con 50% de anticipo para iniciar el proyecto y el 50% restante contra entrega.',
          },
          {
            q: '¿Qué necesito para empezar?',
            a: 'Con contarme tu idea, el rubro de tu negocio y (si tienes) tu logo, textos e imágenes, ya podemos partir. Si no tienes todo listo, te ayudo a definirlo.',
          },
        ].map(item => (
          <details class="group bg-white dark:bg-gray-900 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm open:shadow-md open:border-accent/30 transition">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-5 md:p-6 font-semibold text-gray-900 dark:text-white rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800/60 transition">
              {item.q}
              <span class="text-accent text-xl leading-none shrink-0 transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="px-5 md:px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Habilidades -->
  <section class="py-20 bg-white dark:bg-gray-900 lg:px-32 px-6">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl text-gray-900 dark:text-white">Mis Habilidades</h2>
        <span class="mt-3 mx-auto block h-1 w-10 rounded-full bg-accent"></span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {[
          { name: 'Astro', icon: <IconAstro class="w-9 h-9 mx-auto" /> },
          { name: 'React', icon: <IconReact class="w-9 h-9 mx-auto" /> },
          { name: 'Tailwind', icon: <IconTailwind class="w-9 h-9 mx-auto" /> },
          { name: 'Node.js', icon: <IconNode class="w-9 h-9 mx-auto" /> },
          { name: 'TypeScript', icon: <IconTypescript class="w-9 h-9 mx-auto" /> },
          { name: 'Git', icon: <IconGit class="w-9 h-9 mx-auto" /> },
