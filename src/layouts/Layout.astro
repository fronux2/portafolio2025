---
import '../styles/global.css';
const { 
  title = 'Marcos Muñoz — Desarrollo Web en San Bernardo',
  description = 'Desarrollador web en San Bernardo, Chile. Creo tiendas online, páginas web y landing pages profesionales para emprendedores y pequeños negocios.',
  noindex = false
} = Astro.props;

const canonicalUrl = Astro.url.href;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://marcosm.cl';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/icono-portafolio2.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0891b2">
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${siteUrl}/images/portafolioWeb.webp`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/images/portafolioWeb.webp`} />

  <meta name="description" content={description} />
  <meta name="author" content="Marcos Muñoz" />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `${siteUrl}/#marcos`,
        "name": "Marcos Muñoz",
        "jobTitle": "Desarrollador Web",
        "url": siteUrl,
        "image": `${siteUrl}/images/portafolioWeb.webp`,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "San Bernardo",
          "addressCountry": "CL"
        },
        "sameAs": [
          "https://github.com/fronux2",
          "https://www.linkedin.com/in/marcos-mu%C3%B1oz-gonzalez-a32888270/"
        ],
        "worksFor": { "@id": `${siteUrl}/#negocio` }
      },
      {
        "@type": "ProfessionalService",
        "@id": `${siteUrl}/#negocio`,
        "name": "Marcos Muñoz — Desarrollo Web",
        "description": "Desarrollo de tiendas online, sitios web y landing pages para emprendedores y pequeños negocios en San Bernardo y la Región Metropolitana.",
        "url": siteUrl,
        "image": `${siteUrl}/images/portafolioWeb.webp`,
        "founder": { "@id": `${siteUrl}/#marcos` },
        "telephone": "+56926475227",
        "email": "marcosantonio.munozg@gmail.com",
        "priceRange": "$$",
        "currenciesAccepted": "CLP",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "San Bernardo",
          "addressRegion": "Región Metropolitana",
          "addressCountry": "CL"
        },
        "areaServed": [
          { "@type": "City", "name": "San Bernardo" },
          { "@type": "AdministrativeArea", "name": "Región Metropolitana" },
          { "@type": "Country", "name": "Chile" }
        ],
        "sameAs": [
          "https://github.com/fronux2",
          "https://www.linkedin.com/in/marcos-mu%C3%B1oz-gonzalez-a32888270/"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios de desarrollo web",
          "itemListElement": [
            {
              "@type": "Offer",
              "priceCurrency": "CLP",
              "price": "80000",
              "priceSpecification": {
                "@type": "PriceSpecification",
                "priceCurrency": "CLP",
                "minPrice": "80000"
              },
              "itemOffered": {
                "@type": "Service",
                "name": "Landing Page",
                "description": "Una página con diseño responsive, pensada para convertir visitas en contactos."
              }
            },
            {
              "@type": "Offer",
              "priceCurrency": "CLP",
              "price": "150000",
              "priceSpecification": {
                "@type": "PriceSpecification",
                "priceCurrency": "CLP",
                "minPrice": "150000"
              },
              "itemOffered": {
                "@type": "Service",
                "name": "Sitio Web / Catálogo",
                "description": "Sitio de varias secciones o páginas con catálogo de productos o servicios."
              }
            },
            {
              "@type": "Offer",
              "priceCurrency": "CLP",
              "price": "280000",
              "priceSpecification": {
                "@type": "PriceSpecification",
                "priceCurrency": "CLP",
                "minPrice": "280000"
              },
              "itemOffered": {
                "@type": "Service",
                "name": "Tienda Online",
                "description": "Tienda con catálogo de productos, carrito y proceso de compra."
              }
            }
          ]
        }
      }
    ]
  })} />

  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6HZDWVV3GP"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-6HZDWVV3GP');
      </script>
    </>
  )}
</head>
<body>
  <div class="min-h-screen flex flex-col">
    <slot />

    <!-- Footer -->
    <footer class="mt-auto py-8 bg-black text-white border-t border-white/10">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-gray-400">© {new Date().getFullYear()} Marcos Muñoz. Desarrollo web en San Bernardo, Chile.</p>
      </div>
    </footer>
  </div>
</body>
</html>
