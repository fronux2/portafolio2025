---
import '../styles/global.css';
const { 
  title = 'Marcos Muñoz — Desarrollo Web en San Bernardo',
  description = 'Desarrollador web en San Bernardo, Chile. Creo tiendas online, páginas web y landing pages profesionales para emprendedores y pequeños negocios.',
  noindex = false
} = Astro.props;

const canonicalUrl = Astro.url.href;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://portafoliomarcosm.netlify.app';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/icono-portafolio2.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0891b2">
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${siteUrl}/images/portafolioWeb.webp`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/images/portafolioWeb.webp`} />

  <meta name="description" content={description} />
  <meta name="author" content="Marcos Muñoz" />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Marcos Muñoz",
    "jobTitle": "Desarrollador Web",
    "url": siteUrl,
    "image": `${siteUrl}/images/portafolioWeb.webp`,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "San Bernardo",
      "addressCountry": "CL"
    },
    "sameAs": [
      "https://github.com/fronux2",
      "https://www.linkedin.com/in/marcos-mu%C3%B1oz-gonzalez-a32888270/"
    ]
  })} />

  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6HZDWVV3GP"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-6HZDWVV3GP');
      </script>
    </>
  )}
</head>
<body>
  <div class="min-h-screen flex flex-col">
    <slot />

    <!-- Footer -->
    <footer class="mt-auto py-8 bg-black text-white border-t border-white/10">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-gray-400">© {new Date().getFullYear()} Marcos Muñoz. Desarrollo web en San Bernardo, Chile.</p>
      </div>
    </footer>
  </div>
</body>
</html>
